server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    location ~ ^/api/tmdb/(configuration|genre/movie/list|movie/(popular|top_rated|[0-9]+(/similar)?)|discover/movie|search/movie)$ {
        if ($request_method != GET) { return 405; }
        rewrite ^/api/tmdb/(.*)$ /3/$1 break;
        proxy_pass https://api.themoviedb.org;
        proxy_ssl_server_name on;
        proxy_set_header Host api.themoviedb.org;
        proxy_set_header Authorization "Bearer ${TMDB_READ_ACCESS_TOKEN}";
        proxy_set_header Cookie "";
        proxy_hide_header Set-Cookie;
        proxy_connect_timeout 10s;
        proxy_read_timeout 15s;
    }

    location /api/tmdb/ {
        return 404;
    }

    location /api/movies {
        proxy_pass ${MOVIE_API_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/auth {
        proxy_pass ${USER_API_URL};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        try_files $uri =404;
        expires 7d;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
