{
  "name": "neo4flix-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.cjs",
    "build": "ng build",
    "preview": "ng serve --configuration production --host 127.0.0.1 --proxy-config proxy.conf.cjs",
    "format": "prettier --write \"src/**/*.{ts,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\""
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "gsap": "3.15.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
